# Database (Neon Postgres via Vercel)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth.js
AUTH_SECRET=  # Generate with: npx auth secret
AUTH_URL=http://localhost:3001  # Change to your production URL on Vercel

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Access control — only this email can sign in (leave empty to allow anyone)
ALLOWED_EMAIL=
